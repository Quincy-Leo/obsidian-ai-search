{
  "name": "ai-search",
  "version": "0.1.0",
  "private": true,
  "description": "Use an AI decision model for fast fuzzy search, without exact keyword matching or a complex search engine.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --external:obsidian --format=cjs --platform=browser --target=es2018 --outfile=main.js",
    "check": "npm run build && node --check main.js",
    "test": "node --test ut/*.test.js"
  },
  "devDependencies": {
    "esbuild": "0.28.0"
  }
}
